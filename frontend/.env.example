# ThreatLens frontend — optional settings (copy to .env.local to use)
#
# By default the UI calls the API on the same origin at /api/v1:
#   - in Docker, nginx proxies /api → backend
#   - with `npm start`, the CRA dev server proxies /api → http://localhost:8000 (see "proxy" in package.json)
# Only set this when the API lives on a different origin.
# REACT_APP_API_BASE_URL=https://api.example.com/api/v1

# Dev server port for `npm start`
# PORT=3000
