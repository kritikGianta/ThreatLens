# ═══════════════════════════════════════════════════════════════════════════════
#  ThreatLens — environment configuration
#
#  1. Copy this file:   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#  2. Fill in the values marked [REQUIRED]. Everything marked [OPTIONAL] can stay
#     empty — the platform runs fully without it and the feature degrades gracefully.
#  3. docker compose up -d --build   →   http://localhost:8080
#
#  The same file is read by docker compose AND by the backend when you run it
#  locally (backend/config.py loads ../.env). Never commit your real .env.
# ═══════════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────────
#  CORE  [REQUIRED]
# ───────────────────────────────────────────────────────────────────────────────

# development | production   (production refuses to start with a default JWT_SECRET)
ENVIRONMENT=development

# [REQUIRED] Secret used to sign login tokens. Use a long random string.
#   Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetimes
JWT_ACCESS_EXPIRE_MIN=30
JWT_REFRESH_EXPIRE_DAYS=7

# true  = anyone can create an analyst account from the Sign-up page
# false = only the first account (auto-admin) can self-register; admins create the rest
ALLOW_PUBLIC_SIGNUP=true


# ───────────────────────────────────────────────────────────────────────────────
#  DATABASE (PostgreSQL in Docker)  [REQUIRED]
# ───────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=threatlens
POSTGRES_USER=threatlens
# [REQUIRED] Database password. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-db-password

# Only needed when running the backend OUTSIDE docker against the dockerised DB:
# DATABASE_URL=postgresql+psycopg://threatlens:<POSTGRES_PASSWORD>@localhost:5432/threatlens
# Leave DATABASE_URL unset (and DB_BACKEND=sqlite) for a zero-setup local SQLite file.
DB_BACKEND=sqlite


# ───────────────────────────────────────────────────────────────────────────────
#  AI — Groq LLM  [OPTIONAL, strongly recommended]
#  Powers: AI SOC summaries, the conversational Copilot, LLM fallback log parsing.
#  Without it ThreatLens uses its built-in rule engine to write summaries/answers.
#
#  How to get it (free):
#    1. Go to https://console.groq.com and sign in (Google/GitHub/email).
#    2. Open "API Keys" → "Create API Key", give it a name, copy the key (starts with gsk_).
# ───────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Model used for summaries & Copilot, and a faster model for log parsing.
# See https://console.groq.com/docs/models for currently available model IDs.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant


# ───────────────────────────────────────────────────────────────────────────────
#  VirusTotal  [OPTIONAL]  — IP reputation in Threat Studio + risk scoring
#
#  How to get it (free, 4 lookups/min, 500/day):
#    1. Create an account at https://www.virustotal.com/gui/join-us
#    2. Click your avatar (top-right) → "API key", copy the key.
# ───────────────────────────────────────────────────────────────────────────────
VT_API_KEY=your_virustotal_api_key_here


# ───────────────────────────────────────────────────────────────────────────────
#  NIST NVD  [OPTIONAL]  — CVE enrichment (works without a key at 5 requests / 30 s;
#  a key raises the limit to 50 requests / 30 s)
#
#  How to get it (free):
#    1. Request a key at https://nvd.nist.gov/developers/request-an-api-key
#    2. Confirm the e-mail you receive; the key is shown on the activation page.
# ───────────────────────────────────────────────────────────────────────────────
NVD_API_KEY=your_nvd_api_key_here


# ───────────────────────────────────────────────────────────────────────────────
#  abuse.ch Auth-Key  [OPTIONAL]  — enables the URLhaus and ThreatFox intel feeds
#  (CISA KEV, Feodo Tracker and IPsum feeds work without any key)
#
#  How to get it (free):
#    1. Sign in at https://auth.abuse.ch/ (GitHub, Google, LinkedIn or X login).
#    2. Under "Optional", click "Generate Key" and copy the Auth-Key.
# ───────────────────────────────────────────────────────────────────────────────
ABUSECH_AUTH_KEY=your_abusech_auth_key_here


# ───────────────────────────────────────────────────────────────────────────────
#  IP geolocation  [OPTIONAL]
#  ip-api.com is used by default with no key. These add a fallback + richer detail.
#
#  IPinfo (fallback geolocation, 50k req/month free):
#    1. Sign up at https://ipinfo.io/signup   2. Copy the token from the dashboard.
#  OpenCage (address/timezone enrichment, 2,500 req/day free):
#    1. Sign up at https://opencagedata.com/users/sign_up   2. Dashboard → "Geocoding API" → copy key.
# ───────────────────────────────────────────────────────────────────────────────
IPINFO_TOKEN=your_ipinfo_token_here
OPENCAGE_API_KEY=your_opencage_api_key_here


# ───────────────────────────────────────────────────────────────────────────────
#  SMTP  [OPTIONAL]  — e-mail actions in SOAR alert rules
#
#  Gmail example:
#    1. Turn on 2-Step Verification for the Google account.
#    2. Create an App Password at https://myaccount.google.com/apppasswords
#    3. Use the 16-character app password below (not your normal password).
# ───────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address_here
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM=your_sender_email_here


# ───────────────────────────────────────────────────────────────────────────────
#  Log forwarding  [OPTIONAL]
#  Shared secret for agents (Filebeat, Fluentd, Vector, rsyslog, scripts) that POST
#  to /api/v1/logs/webhook with header  X-API-Key: <value>
#    Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ───────────────────────────────────────────────────────────────────────────────
INGEST_API_KEY=


# ───────────────────────────────────────────────────────────────────────────────
#  LIVE DEMO / PRESENTATIONS  [OPTIONAL]
# ───────────────────────────────────────────────────────────────────────────────
# Start realistic background network traffic automatically (otherwise start it from
# the "Live Demo" page). Rates: low | normal | high
LIVE_TRAFFIC_AUTOSTART=false
LIVE_TRAFFIC_RATE=normal

# Read-only account for judges / visitors (created at startup when a password is set).
# They can see everything update live but cannot change anything.
DEMO_VIEWER_USERNAME=judge
DEMO_VIEWER_PASSWORD=

# Where "your network" sits on the Live Threat Map. Leave empty to use this server's
# public-IP location automatically.
ORG_HQ_NAME=
ORG_HQ_LAT=
ORG_HQ_LON=

# ───────────────────────────────────────────────────────────────────────────────
#  Platform behaviour
# ───────────────────────────────────────────────────────────────────────────────
# Replay a realistic multi-stage attack scenario into an empty database on first start
SEED_DEMO_DATA=true
# Pull threat-intel feeds in the background at startup
INTEL_INGEST_ON_STARTUP=true
# Background jobs: correlation (5m), intel refresh, retention, incident lifecycle
ENABLE_SCHEDULER=true
# Windows Event Log collector — only works when the backend runs natively on Windows
ENABLE_REAL_LOG_COLLECTOR=false
# Allow asset reachability checks against private/internal addresses (SSRF guard)
ALLOW_PRIVATE_ASSET_CHECKS=false

LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
RATE_LIMIT_ENABLED=true

# Comma-separated browser origins allowed to call the API directly
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# Host ports used by docker compose
FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5432
